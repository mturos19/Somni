# Copy this file to `.env.local` and fill in your keys, then restart the dev server.
# `.env.local` is gitignored. Neither key is ever sent to the browser.
#
# Deploying? These go in Vercel under Settings -> Environment Variables instead.
# See DEPLOY.md.

# ---------------------------------------------------------------------------
# Story writing (required)
# ---------------------------------------------------------------------------
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Voice cloning and narration (optional)
# ---------------------------------------------------------------------------
# Create one at https://elevenlabs.io/app/settings/api-keys
#
# Instant Voice Cloning needs at least the Starter plan. Without this key the
# app still works end to end - stories are narrated with the device's built-in
# speech voice instead of yours.
ELEVENLABS_API_KEY=

# Optional overrides.
#
# By default the model follows the app's Steady / Natural / Lively control:
# eleven_multilingual_v2 for the first two, eleven_v3 for Lively. Setting this
# pins one model for all three. eleven_flash_v2_5 is about half the price and
# much faster, at real cost to warmth.
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# For EU/India/Singapore data residency, point at the matching regional host,
# e.g. https://api.eu.residency.elevenlabs.io
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ---------------------------------------------------------------------------
# Public site URL (optional - not needed on Vercel)
# ---------------------------------------------------------------------------
# The absolute origin this copy of Somni is served from, used as the base for
# the share card. On Vercel this is worked out automatically from
# VERCEL_PROJECT_PRODUCTION_URL, so leave it unset.
#
# Set it only when self-hosting, or when serving from a domain that is not the
# project's production domain. No trailing slash. This is the one variable that
# reaches the browser - it is public by design.
# NEXT_PUBLIC_SITE_URL=https://somni.example.com

# ---------------------------------------------------------------------------
# Voice ownership signing (recommended)
# ---------------------------------------------------------------------------
# Signs the cookie that records which cloned voices a browser created, so one
# visitor cannot delete another family's voice. Any long random string:
#   openssl rand -base64 32
#
# If this is unset, the ElevenLabs key is used to derive the signature instead,
# so ownership still works - but then rotating that key signs everyone out of
# their own voices.
SOMNI_SIGNING_SECRET=
