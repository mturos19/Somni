# Copy this file to `.env.local` and fill in your keys, then restart the dev server.
# `.env.local` is gitignored. Neither key is ever sent to the browser.

# ---------------------------------------------------------------------------
# Story writing (required)
# ---------------------------------------------------------------------------
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Voice cloning and narration (optional)
# ---------------------------------------------------------------------------
# Create one at https://elevenlabs.io/app/settings/api-keys
#
# Instant Voice Cloning needs at least the Starter plan. Without this key the
# app still works end to end - stories are narrated with the device's built-in
# speech voice instead of yours.
ELEVENLABS_API_KEY=

# Optional overrides.
#
# eleven_v3 is the default: the expressive model, and the one that takes
# direction from the per-page audio tags Somni sends. eleven_flash_v2_5 is about
# half the price and much faster, at real cost to warmth. The app adapts either
# way - it drops the audio tags a v2 model would read out loud, and re-enables
# the request stitching v3 refuses.
# ELEVENLABS_TTS_MODEL=eleven_v3

# For EU/India/Singapore data residency, point at the matching regional host,
# e.g. https://api.eu.residency.elevenlabs.io
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
