{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somni",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_compat gives the Node built-ins the Anthropic SDK expects.
  // global_fetch_strictly_public keeps fetch() to the public internet, which is
  // what the adapter assumes.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Left at the defaults so this deploys on the free plan. Somni spends its
  // time waiting on Anthropic and ElevenLabs, which is not CPU, and the routes
  // themselves measure in single-digit milliseconds - see DEPLOY.md. On the
  // Workers Paid plan you can raise the ceiling if you ever need it:
  //   "limits": { "cpu_ms": 60000 }
  "observability": {
    "enabled": true
  }
}
